# Kernel configuration fragment for a benchmark host (bench/kernel-build.sh).
# Applied on top of the distribution's running config: no sanitizers, no lockdep,
# everything the suite and the campaign need built in or as modules, and the
# options that make a distro config rebuildable without the distro's signing keys.
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
CONFIG_MODULE_SIG=n
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_INFO_BTF=n
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=n
CONFIG_KASAN=n
CONFIG_UBSAN=n
CONFIG_PROVE_LOCKING=n
CONFIG_LOCKDEP=n
CONFIG_DEBUG_ATOMIC_SLEEP=n
CONFIG_LOCK_STAT=n
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
# casefolded lower directories (issue #95, step casefold)
CONFIG_UNICODE=y
CONFIG_BTRFS_FS=m
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_XFS_FS=m
CONFIG_XFS_POSIX_ACL=y
CONFIG_FS_POSIX_ACL=y
CONFIG_FS_IOMAP=y
CONFIG_CRYPTO_CRC32C=y
CONFIG_LIBCRC32C=y
CONFIG_MD=y
CONFIG_BLK_DEV_DM=m
CONFIG_DM_LOG_WRITES=m
CONFIG_DM_FLAKEY=m
CONFIG_FILE_LOCKING=y
CONFIG_OVERLAY_FS=m
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PERF_EVENTS=y
